# Terraform working directory
.terraform/

# Terraform state may contain infrastructure details
*.tfstate
*.tfstate.*

# Terraform plans
*.tfplan

# Terraform variable files may contain sensitive values
*.tfvars
*.tfvars.json

# Terraform crash and override files
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive files
*.pem
*.key
.env
credentials

# Operating system and editor files
.DS_Store
*.swp
